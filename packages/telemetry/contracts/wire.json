{
  "$comment": "What telemetry may do, as data; no env var, flag or argument changes any of it. url and forget are the one service reports and deletion requests go to; with both empty nothing is dialled. An address set or emptied, a change of unchosen, of betaUntil or of what is collected raises policy and re-pins lock, so no earlier choice or notice covers it. unchosen: ask (setup asks a person) or on (the beta's default for betaModules, from the notice on).",
  "url": "https://api.atlasbound.dev/v1/telemetry/reports",
  "forget": "https://api.atlasbound.dev/v1/telemetry/forget",
  "protocol": "ab-report/1",
  "policy": 2,
  "lock": { "1": "7611d617f88e80518d9ab44648dd59dc2666bae943aca51a57ab4c7edb732dc8", "2": "13f38ee52034fa070ce84d856cab8a48294e238b28890accf272ea49ac6939ad" },
  "unchosen": "on",
  "betaUntil": "2027-03-31",
  "betaModules": ["cli", "db", "handoff"],
  "owners": { "cli": ["cli"], "db": ["decisionbook"], "handoff": ["handoff"] },
  "periodDays": 30,
  "retention": { "days": 30, "months": 13 },
  "limits": { "queueDays": 14, "queueBytes": 1048576, "historyDays": 14, "historyBytes": 2097152, "reportBytes": 60000, "reportRows": 2000,
    "requestBytes": 65536, "requestReports": 64, "answerBytes": 16384, "countCap": 100000, "attemptHours": 24, "retryDays": 7,
    "jitterMinutes": 60, "forgetTries": 14, "pairMinutes": 10, "closeRows": 200000 },
  "os": { "darwin": "macos", "linux": "linux", "win32": "windows" },
